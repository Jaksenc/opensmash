{
  "name": "opensmash-web-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch server/index.js",
    "dev:safe": "NODE_ENV=development FIGHTER_WORKER_DISABLED=1 node --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "worker": "NODE_ENV=production node server/worker.js",
    "test": "node --test server/*.test.js shared/*.test.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/run": "^4.0.0",
    "@google-cloud/storage": "^8.0.1",
    "@vitejs/plugin-react": "latest",
    "@zip.js/zip.js": "^2.8.61",
    "busboy": "^1.6.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.0"
}
