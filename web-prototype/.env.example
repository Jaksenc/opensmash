# Local defaults need no environment variables. Copy this file to .env.local
# and pass it with: node --env-file=.env.local server/index.js

COOKIE_SECRET=replace-with-at-least-32-random-bytes
HOST=127.0.0.1
PORT=4174

# Durable production services. Leave both as "local" for zero-setup development.
JOB_DATABASE=local
OBJECT_STORE=local
FIGHTER_EXECUTION_MODE=local
FIGHTER_JOBS_ROOT=./data/fighter-jobs
OBJECT_STORE_ROOT=./data/objects

# GCP deployment values:
# JOB_DATABASE=firestore
# OBJECT_STORE=gcs
# FIGHTER_EXECUTION_MODE=cloud-run
# GOOGLE_CLOUD_PROJECT=opensmash-production
# FIRESTORE_JOBS_COLLECTION=fighterJobs
# CLOUD_RUN_REGION=us-central1
# CLOUD_RUN_WORKER_JOB=opensmash-fighter-worker
# GCS_PRIVATE_BUCKET=opensmash-fighter-sources
# GCS_PUBLIC_BUCKET=opensmash-fighter-assets
# ASSET_BASE_URL=https://assets.example.com
# ALLOWED_ORIGINS=https://example.com

MAX_ACTIVE_JOBS_PER_OWNER=1
MAX_DAILY_JOBS_PER_OWNER=3
MAX_GLOBAL_ACTIVE_JOBS=20
ROM_VALIDATION_LIMIT=10
FIGHTER_LEASE_SECONDS=900

# Prevent paid provider work while exercising the UI/API.
FIGHTER_WORKER_DISABLED=1
